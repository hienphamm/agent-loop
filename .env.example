# Copy this file to .env and fill in the values you need.
# Never commit the real .env file — it is already listed in .gitignore.

# --- Reviewer / Planner role ---------------------------------------------
AGENT_LOOP_REVIEWER_PROVIDER=anthropic
AGENT_LOOP_REVIEWER_MODEL=claude-sonnet-5
# auth mode: "cli" (provider CLI login/session) or "api_key"
AGENT_LOOP_REVIEWER_AUTH=api_key
AGENT_LOOP_REVIEWER_API_KEY=

# --- Developer / Executor role -------------------------------------------
AGENT_LOOP_DEVELOPER_PROVIDER=openai
AGENT_LOOP_DEVELOPER_MODEL=gpt-model
AGENT_LOOP_DEVELOPER_AUTH=api_key
AGENT_LOOP_DEVELOPER_API_KEY=

# --- Provider-specific API keys (used when a role's *_API_KEY is unset) --
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Execution -------------------------------------------------------------
AGENT_LOOP_WORKSPACE=./project
AGENT_LOOP_APPROVAL_MODE=manual

# --- Context management -----------------------------------------------------
AGENT_LOOP_CONTEXT_TOKEN_BUDGET=100000
AGENT_LOOP_MAX_REVIEW_ROUNDS=3

# --- Provider CLI login (only needed when *_AUTH=cli) -----------------------
# The command that reports whether a session is active (must exit 0 when logged in).
# AGENT_LOOP_REVIEWER_CLI_CHECK_COMMAND=codex login status
# The command to show the user when no session is active.
# AGENT_LOOP_REVIEWER_CLI_LOGIN_COMMAND=codex login
