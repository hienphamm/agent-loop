{
  "name": "agent-loop",
  "version": "0.1.0",
  "description": "CLI-first, local-only orchestrator for a Planner/Reviewer and Developer/Executor agent loop.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hienphamm/agent-loop.git"
  },
  "homepage": "https://github.com/hienphamm/agent-loop#readme",
  "bugs": {
    "url": "https://github.com/hienphamm/agent-loop/issues"
  },
  "keywords": [
    "cli",
    "agent",
    "orchestrator",
    "planner",
    "executor",
    "llm"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "agent-loop": "./dist/cli/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    ".env.example",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
